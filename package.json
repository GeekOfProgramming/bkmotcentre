{
  "name": "bkmotcentre",
  "version": "1.0.0",
  "description": "BK MOT Centre Ltd Web Platform",
  "scripts": {
    "build": "node tools/build.js",
    "build:watch": "node tools/build.js --watch",
    "dev": "node tools/build.js && npx live-server --port=3000 --open=index.html",
    "start": "node tools/build.js && npx live-server --port=3000 --open=index.html",
    "preview": "python -m http.server 3000",
    "deploy": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "pages:dev": "npx wrangler pages dev ."
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "keywords": ["mot", "garage", "bkmotcentre", "cloudflare-pages", "cloudflare-workers"],
  "author": "BK MOT Centre Ltd",
  "license": "ISC"
}
