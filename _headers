# Cloudflare Workers & Pages Security & Caching Headers

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000
  X-XSS-Protection: 1; mode=block

# Disallow caching for all API endpoints
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0

# Cache static images and fonts for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 week with stale-while-revalidate
/css/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Favicons and XML/Text assets
/favicon.*
  Cache-Control: public, max-age=2592000

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

# Ensure immediate freshness for compiled HTML
/*.html
  Cache-Control: public, max-age=0, must-revalidate
