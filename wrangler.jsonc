{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bkmotcentre",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_FROM_EMAIL": "BK MOT Centre <bookings@bkmotcentre.uk>",
    "CONTACT_TO_EMAIL": "bkmotcentre@gmail.com"
  }
}
